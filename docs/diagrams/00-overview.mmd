  user -- "HTTPS (OBO)" --> app
  app -- "grounded ask" --> sup
  app -. "direct chat" .-> fm
  app -- "state + upload search" --> lb
  app -- "run-now" --> ingest
  sup -- "documents" --> rag
  sup -- "structured data" --> genie
  sup -- "domain tools" --> tools
  tools --> ext
  sup & rag -- "LLM, translate, embed" --> gws
  gws --> fm & bge
  rag -- "HYBRID query" --> vs
  vs -- "embeddings" --> bge
  genie -- "SQL" --> uc
  etl -- "parse + chunk" --> uc
  uc -- "Delta Sync" --> vs
  ingest -- "chunks + vectors" --> lb
  evals -- "predict + judge" --> rag
  sup & rag -. "traces" .-> exp
  evals --> exp --> dash
