  out(["answer, sources, qrs, ars, hi_eq, hi_rf, trace_id"]):::user

  req --> cfgstep
  cfgtbl -. "only if MYGPT_WAREHOUSE_ID is set (not in the deployed agent)" .-> cfgstep
  tr -- "POST /invocations" --> translate
  retr -- "corpus libraries: filters corpus / source_name / section" --> index
  provided -- "upload libraries: skip Vector Search" --> retr
  gen -- "model=sonnet (default)" --> chat
  gen -. "model=llama / gptoss (eval matrix)" .-> direct
  score -- "answer embeddings" --> emb
  score --> out
  agent -- "RETRIEVER / LLM spans" --> exp
  agent -. "if langsmith_api_key secret exists" .-> ls
