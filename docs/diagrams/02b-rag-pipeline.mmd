    retr{"3 · retrieve"}:::job
    rerank["4 · rerank<br/><i>in-process cross-encoder</i><br/>qnli-electra-base · mmarco-mMiniLMv2"]:::job
    qrs["5 · QRS<br/><i>vector + BM25 + rerank</i>"]:::job
