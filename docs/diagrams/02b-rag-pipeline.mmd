  %% 02b Inside mygpt-rag-agent (agents/rag_agent/agent.py): one request, step by step
  req(["request from mygpt-supervisor or mygpt_eval<br/><i>custom_inputs: corpus, sources?, model, k</i>"]):::user

  subgraph agent["mygpt-rag-agent · ResponsesAgent (UC model mygpt_rag_agent)"]
    direction LR
    cfgstep["1 · dataset config<br/><i>packaged defaults</i>"]:::job
