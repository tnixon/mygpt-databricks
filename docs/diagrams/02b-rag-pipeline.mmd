    score["7 · score answer<br/><i>ARS · NLI (nli-deberta-v3-base)<br/>HI equation + random forest</i>"]:::job
    cfgstep --> tr --> retr --> rerank --> qrs --> gen --> score
  end

  cfgtbl["dataset_config · embedding_model_cutoffs · reranker_config<br/><i>UC tables</i>"]:::tbl
