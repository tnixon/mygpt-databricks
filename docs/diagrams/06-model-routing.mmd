    translate["mygpt-translate<br/><i>llm/v1/chat · 60 calls/min/user<br/>inference table mygpt_translate_payload</i>"]:::gw
    emb["mygpt-embeddings<br/><i>llm/v1/embeddings</i>"]:::gw
  end

  subgraph fmx["FMAPI · pay-per-token (shared)"]
    direction TB
    sonnet["databricks-claude-sonnet-5"]:::fm
    gemma["databricks-gemma-3-12b"]:::fm
    llama["databricks-llama-4-maverick"]:::fm
    gptoss["databricks-gpt-oss-120b"]:::fm
    opus["databricks-claude-opus-5-5"]:::fm
  end
  bge["mygpt-bge-m3<br/><i>custom endpoint · UC model bge_m3<br/>GPU_SMALL · always on</i>"]:::ep
  azure(["Azure AI Foundry<br/><i>0% traffic fallback · not configured</i>"]):::ext
  secret["mygpt / gw_upstream_token<br/><i>secret: gateway → upstream auth</i>"]:::note
  usage[("system.serving.endpoint_usage<br/><i>requests + tokens per caller</i>")]:::ext

  appd -- "AppKit serving plugin" --> sonnet & llama & gptoss
  appq -- "embed question" --> emb
  sup -- "router + merge LLM" --> chat
  rag -- "generate (model=sonnet)" --> chat
  rag -- "translate" --> translate
  rag -- "answer embeddings" --> emb
  rag -. "generate (model=llama / gptoss)" .-> llama & gptoss
  ingest -- "embed chunks" --> emb
  vsidx -- "managed embeddings (gateways not supported)" --> bge
  evals -- "LLM judges" --> opus
  chat --> sonnet
  chat -. "fallback" .-> azure
  translate --> gemma
  emb --> bge
  secret -.- chat & translate & emb
  gws -. "usage tracking" .-> usage
