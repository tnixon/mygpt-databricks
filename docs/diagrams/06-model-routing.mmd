  subgraph callers["Callers"]
    direction TB
    appd["st-jude-mygpt · direct chat<br/><i>OBO user · usage_context app-direct</i>"]:::app
    appq["st-jude-mygpt · upload search<br/><i>app SP</i>"]:::app
    sup["mygpt-supervisor<br/><i>endpoint SP</i>"]:::ep
    rag["mygpt-rag-agent<br/><i>endpoint SP</i>"]:::ep
