# Local LangSmith credentials (copy to .env, which is gitignored and never synced to the workspace).
# Deployed endpoints don't read this file: `make langsmith-secret` stores LANGSMITH_API_KEY in the
# mygpt secret scope, and the agent drivers point the endpoints at it (DEPLOYMENT.md step 4).
# Local runs load it with:  uv run --env-file .env ...   or   set -a; . ./.env; set +a
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mygpt
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Needed when the API key is org-scoped (selects the workspace)
LANGSMITH_WORKSPACE_ID=
# Uncomment to send only the run tree, timings and metadata (no questions, chunks or answers)
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
